---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const featured = siteConfig.projects.slice(0, 6);
const gallery = siteConfig.projects.slice(6);
---

{hasProjects && (
  <>
    <div class="w-full h-1 accent-bar-shimmer" style={`background: linear-gradient(90deg, ${siteConfig.accentColor} 0%, ${siteConfig.highlightColor} 50%, ${siteConfig.accentColor} 100%)`}></div>

    <section id="projects" class="py-12 md:py-16 bg-gray-50">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="mb-10 reveal-left">
          <h2 class="text-3xl md:text-4xl font-bold" style={`color: ${siteConfig.accentColor}`}>Liderazgo y Trayectoria</h2>
          <div class="w-16 h-1 mt-3 rounded-full" style={`background-color: ${siteConfig.highlightColor}`}></div>
        </div>

        <!-- Featured Projects (top 6) -->
        <div class="projects-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featured.map((project, index) => (
            <div
              class={`reveal stagger-${index + 1} group project-card relative p-6 rounded-xl bg-white card-hover card-shine`}
              style={`border: 1px solid ${siteConfig.accentColor}15;`}
            >
              <div class="flex items-start justify-between mb-4">
                <div
                  class="w-10 h-10 rounded-lg flex items-center justify-center text-sm font-bold transition-transform duration-300 group-hover:scale-110"
                  style={`background-color: ${siteConfig.highlightColor}20; color: ${siteConfig.highlightColor}`}
                >
                  0{index + 1}
                </div>

                {project.image && (
                  <div class="project-thumb-wrap relative">
                    <button
                      class="w-11 h-11 rounded-lg overflow-hidden shadow-sm ring-1 ring-black/5 transition-transform duration-300 group-hover:scale-105 cursor-pointer"
                      data-lightbox-trigger
                      data-lightbox-src={project.image}
                      data-lightbox-alt={project.name}
                      aria-label={`Ver foto: ${project.name}`}
                    >
                      <img src={project.image} alt="" class="w-full h-full object-cover" loading="lazy" />
                    </button>
                    <div class="project-float hidden md:block absolute top-0 right-0 w-64 rounded-xl overflow-hidden shadow-2xl ring-1 ring-black/10 bg-white opacity-0 scale-90 pointer-events-none transition-all duration-400 ease-out origin-top-right">
                      <img src={project.image} alt={project.name} class="w-full max-h-72 object-cover object-top" loading="lazy" />
                    </div>
                  </div>
                )}
              </div>

              <h3 class="text-lg font-semibold mb-2" style={`color: ${siteConfig.accentColor}`}>
                {project.name}
              </h3>
              <p class="text-sm text-gray-600 mb-4 leading-relaxed">
                {project.description}
              </p>

              {project.skills && project.skills.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {project.skills.map((skill) => (
                    <span class="text-xs px-2 py-1 rounded-full" style={`background-color: ${siteConfig.accentColor}08; color: ${siteConfig.accentColor}`}>
                      {skill}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Gallery: more events/activities -->
        {gallery.length > 0 && (
          <div class="mt-10 reveal">
            <h3 class="text-sm font-semibold uppercase tracking-wider mb-5" style={`color: ${siteConfig.accentColor}`}>
              Más conferencias, talleres y formación
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3">
              {gallery.map((project) => (
                <button
                  class="gallery-card group relative rounded-xl overflow-hidden shadow-sm ring-1 ring-black/5 aspect-square cursor-pointer"
                  data-lightbox-trigger
                  data-lightbox-src={project.image}
                  data-lightbox-alt={project.name}
                  aria-label={`Ver foto: ${project.name}`}
                >
                  <img src={project.image} alt={project.name} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-2">
                    <span class="text-white text-xs font-medium leading-tight">{project.name}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox-overlay" aria-hidden="true" role="dialog" aria-label="Vista de imagen">
      <button class="lightbox-close" aria-label="Cerrar">&times;</button>
      <img id="lightbox-img" src="" alt="" class="lightbox-image" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>

    <script>
      // Lightbox functionality
      const lightbox = document.getElementById('lightbox')!;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lightboxCaption = document.getElementById('lightbox-caption')!;
      const lightboxClose = lightbox.querySelector('.lightbox-close')!;

      // Open lightbox
      document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const el = trigger as HTMLElement;
          lightboxImg.src = el.dataset.lightboxSrc || '';
          lightboxImg.alt = el.dataset.lightboxAlt || '';
          lightboxCaption.textContent = el.dataset.lightboxAlt || '';
          lightbox.classList.add('active');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      // Close lightbox
      function closeLightbox() {
        lightbox.classList.remove('active');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      lightboxClose.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox.classList.contains('active')) closeLightbox();
      });
    </script>
  </>
)}
